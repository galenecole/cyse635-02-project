"""MNIST CNN classifier (PyTorch) with analysis outputs.

Run:  python mnist_cnn.py
Outputs (in ./outputs): training curves, confusion matrix, filters,
feature maps, misclassified samples, hyperparameter sweep, results.json,
best_model.pt
"""
import json
import struct
import time
from pathlib import Path

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
import torch
import torch.nn as nn
import torch.nn.functional as F
from torch.utils.data import DataLoader, TensorDataset, random_split

ROOT = Path(__file__).parent
DATA = ROOT / "mnist"
OUT = ROOT / "outputs"
OUT.mkdir(exist_ok=True)
SEED = 42
DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")
torch.manual_seed(SEED)
np.random.seed(SEED)


# ---------------------------------------------------------------- data
def read_idx(path):
    """Parse an IDX file (images or labels) into a numpy array."""
    with open(path, "rb") as f:
        _, _, _, ndim = struct.unpack(">BBBB", f.read(4))
        shape = struct.unpack(">" + "I" * ndim, f.read(4 * ndim))
        return np.frombuffer(f.read(), dtype=np.uint8).reshape(shape)


def load_data():
    x_tr = read_idx(DATA / "train-images.idx3-ubyte")
    y_tr = read_idx(DATA / "train-labels.idx1-ubyte")
    x_te = read_idx(DATA / "t10k-images.idx3-ubyte")
    y_te = read_idx(DATA / "t10k-labels.idx1-ubyte")
    # Scale to [0,1] then standardise with the well-known MNIST mean/std.
    prep = lambda x: ((torch.tensor(x, dtype=torch.float32) / 255.0 - 0.1307) / 0.3081).unsqueeze(1)
    return prep(x_tr), torch.tensor(y_tr, dtype=torch.long), prep(x_te), torch.tensor(y_te, dtype=torch.long)


def augment(x, max_shift=2):
    """Cheap augmentation: random translation by up to max_shift pixels (batch-wise)."""
    dx, dy = np.random.randint(-max_shift, max_shift + 1, 2)
    return torch.roll(x, shifts=(int(dy), int(dx)), dims=(2, 3))


# ---------------------------------------------------------------- model
class ConvBlock(nn.Module):
    """Conv -> BatchNorm -> ReLU, twice, then max-pool and spatial dropout."""
    def __init__(self, cin, cout, p):
        super().__init__()
        self.c1 = nn.Conv2d(cin, cout, 3, padding=1, bias=False)
        self.b1 = nn.BatchNorm2d(cout)
        self.c2 = nn.Conv2d(cout, cout, 3, padding=1, bias=False)
        self.b2 = nn.BatchNorm2d(cout)
        self.drop = nn.Dropout2d(p)

    def forward(self, x):
        x = F.relu(self.b1(self.c1(x)))
        x = F.relu(self.b2(self.c2(x)))
        return self.drop(F.max_pool2d(x, 2))


class MNISTNet(nn.Module):
    def __init__(self, c1=32, c2=64, fc=128, p_conv=0.1, p_fc=0.4):
        super().__init__()
        self.block1 = ConvBlock(1, c1, p_conv)    # 28 -> 14
        self.block2 = ConvBlock(c1, c2, p_conv)   # 14 -> 7
        self.fc1 = nn.Linear(c2 * 7 * 7, fc)
        self.drop = nn.Dropout(p_fc)
        self.fc2 = nn.Linear(fc, 10)

    def forward(self, x):
        x = self.block2(self.block1(x))
        x = self.drop(F.relu(self.fc1(x.flatten(1))))
        return self.fc2(x)


# ---------------------------------------------------------------- train / eval
@torch.no_grad()
def evaluate(model, loader):
    model.eval()
    loss, correct, n = 0.0, 0, 0
    preds, labels = [], []
    for x, y in loader:
        x, y = x.to(DEVICE), y.to(DEVICE)
        out = model(x)
        loss += F.cross_entropy(out, y, reduction="sum").item()
        p = out.argmax(1)
        correct += (p == y).sum().item()
        n += len(y)
        preds.append(p.cpu())
        labels.append(y.cpu())
    return loss / n, correct / n, torch.cat(preds).numpy(), torch.cat(labels).numpy()


def train(cfg, train_set, val_set, epochs=30, patience=5, verbose=True):
    """Train with Adam + weight decay, cosine LR, label smoothing-free CE, early stopping on val loss."""
    model = MNISTNet(cfg["c1"], cfg["c2"], cfg["fc"], cfg["p_conv"], cfg["p_fc"]).to(DEVICE)
    opt = torch.optim.AdamW(model.parameters(), lr=cfg["lr"], weight_decay=cfg["wd"])
    sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=epochs)
    tl = DataLoader(train_set, batch_size=cfg["bs"], shuffle=True)
    vl = DataLoader(val_set, batch_size=1000)
    hist = {"train_loss": [], "train_acc": [], "val_loss": [], "val_acc": []}
    best, best_state, bad = float("inf"), None, 0
    for ep in range(1, epochs + 1):
        model.train()
        tot, corr, n = 0.0, 0, 0
        for x, y in tl:
            x, y = x.to(DEVICE), y.to(DEVICE)
            if cfg.get("aug", True):
                x = augment(x)
            opt.zero_grad()
            out = model(x)
            loss = F.cross_entropy(out, y)
            loss.backward()
            opt.step()
            tot += loss.item() * len(y)
            corr += (out.argmax(1) == y).sum().item()
            n += len(y)
        sched.step()
        vloss, vacc, _, _ = evaluate(model, vl)
        for k, v in zip(hist, (tot / n, corr / n, vloss, vacc)):
            hist[k].append(v)
        if verbose:
            print(f"  ep {ep:02d} train {tot/n:.4f}/{corr/n:.4f} val {vloss:.4f}/{vacc:.4f}")
        if vloss < best:
            best, bad = vloss, 0
            best_state = {k: v.clone() for k, v in model.state_dict().items()}
        else:
            bad += 1
            if bad >= patience:
                if verbose:
                    print("  early stopping")
                break
    model.load_state_dict(best_state)
    return model, hist


# ---------------------------------------------------------------- plots
def plot_history(hist, path):
    fig, ax = plt.subplots(1, 2, figsize=(10, 4))
    ep = range(1, len(hist["train_loss"]) + 1)
    ax[0].plot(ep, hist["train_loss"], label="train")
    ax[0].plot(ep, hist["val_loss"], label="validation")
    ax[0].set(title="Loss", xlabel="Epoch", ylabel="Cross-entropy")
    ax[1].plot(ep, hist["train_acc"], label="train")
    ax[1].plot(ep, hist["val_acc"], label="validation")
    ax[1].set(title="Accuracy", xlabel="Epoch", ylabel="Accuracy")
    for a in ax:
        a.legend()
        a.grid(alpha=.3)
    fig.tight_layout()
    fig.savefig(path, dpi=150)
    plt.close(fig)


def confusion(y, p):
    m = np.zeros((10, 10), dtype=int)
    np.add.at(m, (y, p), 1)
    return m


def plot_confusion(m, path):
    fig, ax = plt.subplots(figsize=(6, 5))
    im = ax.imshow(m, cmap="Blues")
    ax.set(xlabel="Predicted", ylabel="True", title="Confusion matrix (test set)",
           xticks=range(10), yticks=range(10))
    for i in range(10):
        for j in range(10):
            ax.text(j, i, m[i, j], ha="center", va="center", fontsize=7,
                    color="white" if m[i, j] > m.max() / 2 else "black")
    fig.colorbar(im)
    fig.tight_layout()
    fig.savefig(path, dpi=150)
    plt.close(fig)


def plot_filters(model, path):
    w = model.block1.c1.weight.detach().cpu().numpy()  # (C,1,3,3)
    fig, axes = plt.subplots(4, 8, figsize=(8, 4.4))
    for a, f in zip(axes.flat, w):
        a.imshow(f[0], cmap="gray")
        a.axis("off")
    fig.suptitle("First-layer 3x3 convolution filters")
    fig.tight_layout()
    fig.savefig(path, dpi=150)
    plt.close(fig)


@torch.no_grad()
def plot_feature_maps(model, x, path):
    model.eval()
    x = x.unsqueeze(0).to(DEVICE)
    b1 = model.block1
    f1 = F.relu(b1.b1(b1.c1(x)))                       # first conv output
    f2 = F.relu(b1.b2(b1.c2(f1)))                      # second conv output
    f3 = model.block2.c1(F.max_pool2d(f2, 2))          # block 2 conv (pre-BN) output
    f3 = F.relu(model.block2.b1(f3))
    fig, axes = plt.subplots(4, 8, figsize=(10, 5.6))
    rows = [("Input", None), ("Conv1_1", f1), ("Conv1_2", f2), ("Conv2_1", f3)]
    for r, (name, f) in enumerate(rows):
        for c in range(8):
            a = axes[r, c]
            a.axis("off")
            if f is None:
                if c == 0:
                    a.imshow(x[0, 0].cpu(), cmap="gray")
            else:
                a.imshow(f[0, c].cpu(), cmap="viridis")
            if c == 0:
                a.set_title(name, fontsize=8, loc="left")
    fig.suptitle("Feature maps for one test digit (first 8 channels per layer)")
    fig.tight_layout()
    fig.savefig(path, dpi=150)
    plt.close(fig)


def plot_errors(x, y, p, path, k=16):
    idx = np.where(y != p)[0][:k]
    fig, axes = plt.subplots(2, 8, figsize=(10, 3))
    for a in axes.flat:
        a.axis("off")
    for a, i in zip(axes.flat, idx):
        a.imshow(x[i, 0], cmap="gray")
        a.set_title(f"T:{y[i]} P:{p[i]}", fontsize=8)
    fig.suptitle("Misclassified test digits (T=true, P=predicted)")
    fig.tight_layout()
    fig.savefig(path, dpi=150)
    plt.close(fig)


# ---------------------------------------------------------------- main
def main():
    x_tr, y_tr, x_te, y_te = load_data()
    full = TensorDataset(x_tr, y_tr)
    train_set, val_set = random_split(full, [54000, 6000], generator=torch.Generator().manual_seed(SEED))
    test_loader = DataLoader(TensorDataset(x_te, y_te), batch_size=1000)
    print("device:", DEVICE)

    base = dict(c1=32, c2=64, fc=128, p_conv=0.1, p_fc=0.4, lr=1e-3, wd=1e-4, bs=128, aug=True)

    # ---- main model
    t0 = time.time()
    model, hist = train(base, train_set, val_set, epochs=30, patience=5)
    train_time = time.time() - t0
    plot_history(hist, OUT / "training_curves.png")
    torch.save(model.state_dict(), OUT / "best_model.pt")

    tl, ta, _, _ = evaluate(model, DataLoader(train_set, batch_size=1000))
    _, va, _, _ = evaluate(model, DataLoader(val_set, batch_size=1000))
    te_loss, te_acc, preds, labels = evaluate(model, test_loader)
    cm = confusion(labels, preds)
    plot_confusion(cm, OUT / "confusion_matrix.png")
    per_class = {}
    for c in range(10):
        tp = cm[c, c]
        prec = tp / max(cm[:, c].sum(), 1)
        rec = tp / max(cm[c].sum(), 1)
        f1 = 2 * prec * rec / max(prec + rec, 1e-12)
        per_class[str(c)] = dict(precision=prec, recall=rec, f1=f1, support=int(cm[c].sum()))
    n_params = sum(p.numel() for p in model.parameters())
    print(f"TEST acc {te_acc:.4f} loss {te_loss:.4f} params {n_params} time {train_time:.0f}s")

    plot_filters(model, OUT / "filters.png")
    plot_feature_maps(model, x_te[0], OUT / "feature_maps.png")
    plot_errors(x_te.numpy(), labels, preds, OUT / "misclassified.png")

    # ---- hyperparameter sweep (one factor at a time, short training)
    sweeps = {
        "lr": [1e-4, 1e-3, 1e-2],
        "p_fc": [0.0, 0.4, 0.7],
        "bs": [32, 128, 512],
        "c2": [16, 64, 128],
        "aug": [False, True],
    }
    sweep_res = {}
    for key, vals in sweeps.items():
        sweep_res[key] = []
        for v in vals:
            cfg = dict(base, **{key: v})
            print(f"sweep {key}={v}")
            m, h = train(cfg, train_set, val_set, epochs=8, patience=3, verbose=False)
            _, acc, _, _ = evaluate(m, test_loader)
            sweep_res[key].append(dict(value=v, test_acc=acc, final_train_acc=h["train_acc"][-1],
                                       best_val_acc=max(h["val_acc"])))
            print(f"   test acc {acc:.4f}")

    fig, axes = plt.subplots(1, len(sweeps), figsize=(16, 3.4))
    for a, (k, rs) in zip(axes, sweep_res.items()):
        a.plot([str(r["value"]) for r in rs], [r["test_acc"] for r in rs], "o-")
        a.set(title=k, xlabel=k, ylabel="Test accuracy")
        a.grid(alpha=.3)
    fig.tight_layout()
    fig.savefig(OUT / "hyperparameter_sweep.png", dpi=150)
    plt.close(fig)

    results = dict(config=base, params=n_params, epochs_run=len(hist["train_loss"]),
                   train_time_s=train_time, train_acc=ta, val_acc=va, test_acc=te_acc,
                   test_loss=te_loss, per_class=per_class, confusion=cm.tolist(),
                   num_errors=int((preds != labels).sum()), sweep=sweep_res)
    (OUT / "results.json").write_text(json.dumps(results, indent=2, default=float))
    print("Done. Outputs in", OUT)


if __name__ == "__main__":
    main()
